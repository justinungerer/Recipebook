<Window x:Class="RecipeTool.App.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe details" Width="760" Height="760" MinWidth="640" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PaperBrush}"
        Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="EditorHeading" Text="Recipe details" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Add or edit a family recipe. You can change every captured field before saving."
                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,12" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Recipe name" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" AutomationProperties.Name="Recipe name" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="CategoryBox" IsEditable="True" IsTextSearchEnabled="True" Padding="6"
                          AutomationProperties.Name="Category" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Servings" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="ServingsBox" AutomationProperties.Name="Servings" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Short description" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="DescriptionBox" AutomationProperties.Name="Short description" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Tags (separate with commas)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TagsBox" AutomationProperties.Name="Tags" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Ingredients (one per line)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="IngredientsBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="180"
                         AutomationProperties.Name="Ingredients" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Directions (one step per line)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="InstructionsBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="180"
                         AutomationProperties.Name="Directions" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="72"
                         AutomationProperties.Name="Notes" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Source webpage" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="SourceBox" AutomationProperties.Name="Source webpage" />
                <CheckBox x:Name="ReviewCheckBox" Content="Still needs review" Margin="0,9,0,0" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            <Button Content="Save recipe" IsDefault="True" MinWidth="110" Background="{StaticResource AccentBrush}"
                    Foreground="White" BorderThickness="0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
