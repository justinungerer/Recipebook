<Window x:Class="RecipeTool.App.CategoryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe captured" Width="460" Height="250"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource PaperBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Recipe captured!" FontSize="21" FontWeight="SemiBold" />
        <TextBlock x:Name="RecipeNameText" Grid.Row="1" TextWrapping="Wrap" Margin="0,6,0,12"
                   Foreground="{StaticResource MutedBrush}" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="Which category should it go in?" FontWeight="SemiBold" />
            <ComboBox x:Name="CategoryBox" Margin="0,4,0,0" AutomationProperties.Name="Category" />
        </StackPanel>
        <Button Grid.Row="4" Content="Save" IsDefault="True" MinWidth="100" HorizontalAlignment="Right"
                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                Click="Save_Click" />
    </Grid>
</Window>
